<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Доступ в сеть и информация о текущем подключении (пригодится на этапе 2). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground-служба для активного VPN. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14: тип specialUse для VPN-туннеля. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Android 13+: разрешение на показ уведомления в шторке. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Этап 4: видимость установленных приложений для Per-App VPN. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".ZapretApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ZapretByeDPI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.AppListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.DomainListActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.TelegramActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.LogActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <service
            android:name=".telegram.TelegramProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="telegram_ws_proxy" />
        </service>

        <!--
          VPN-служба.

          BIND_VPN_SERVICE — системное разрешение: только система может
          подключиться к службе, обычные приложения не могут.
          exported=false — снаружи служба недоступна.
          foregroundServiceType=specialUse — требование Android 14 для
          foreground-служб, которые не попадают в стандартные типы.
          property ... FGS_SUBTYPE — пояснение для системы, зачем нужен
          тип specialUse.
        -->
        <service
            android:name=".service.ZapretVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn_tunnel" />
        </service>

    </application>

</manifest>
