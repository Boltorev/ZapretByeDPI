<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      Базовая тема Material 3.
      NoActionBar: свой заголовок в layout, без системного ActionBar.
      DayNight: светлая/тёмная тема выбирается системой.
    -->
    <style name="Theme.ZapretByeDPI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_green_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_container</item>

        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/outline</item>

        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!--
      Мелкий заголовок карточки: «СОСТОЯНИЕ», «ЖУРНАЛ» и т.п.
      Наследуем размер/шрифт от Material 3, меняем цвет и трекинг.
    -->
    <style name="TextAppearance.Zapret.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

</resources>
