<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 и ниже: полный запрет резервного копирования.
  Приложение хранит настройки VPN и списки доменов — они не должны
  попадать в облачный бэкап.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
